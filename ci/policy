#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
exec .venv/bin/python - "$@" <<'PYTHON'
import hashlib
import re
import shutil
import sys
import urllib.request
from pathlib import Path

import toml
from unbake import atomic
from unbake.config import Host

if len(sys.argv) != 2 or not Path(sys.argv[1]).is_absolute():
    sys.exit("usage: ci/policy ABSOLUTE_SCRATCH")
root = Path(sys.argv[1])
for directory in (root, root / "tmp", root / "cache", root / "toolbin"):
    directory.mkdir(parents=True, exist_ok=True)
text = Path("src/unbake/templates/unbake.toml").read_text()
text = re.sub(r'^# domain = "/.*$', '', text, flags=re.M)
values = toml.loads(re.sub(r'^# (\w+ = .*)$', r'\1', text, flags=re.M))
values["resources"].update(domain="standalone", cores=2, workers=1, memory_total_bytes=4000000000,
                            memory_parent_bytes=1000000000, memory_worker_bytes=512000000)
values["cache"].update(machine_root=str(root / "cache"), memory_bytes=256000000)
for field, name in {"make": "make", "cpp": "cpp", "mips_as": "mips-linux-gnu-as",
                    "mips_ld": "mips-linux-gnu-ld", "mips_objcopy": "mips-linux-gnu-objcopy",
                    "mips_objdump": "mips-linux-gnu-objdump", "mips_readelf": "mips-linux-gnu-readelf",
                    "n64link": "n64link", "m2c": "m2c", "splat": "splat"}.items():
    path = shutil.which(name)
    if path is None:
        sys.exit(f"missing tool: {name}")
    values["tools"][field] = str(Path(path).absolute())
for name in ("make", "cpp", "n64link", "mips-linux-gnu-as", "mips-linux-gnu-ld", "mips-linux-gnu-objcopy",
             "mips-linux-gnu-objdump", "mips-linux-gnu-readelf", "sh", "mkdir", "rm", "cp", "cat", "cmp", "sed"):
    path = shutil.which(name)
    if path is None:
        sys.exit(f"missing tool: {name}")
    link = root / "toolbin" / name
    if link.is_symlink() and link.readlink() == Path(path).absolute():
        continue
    if link.exists() or link.is_symlink():
        sys.exit(f"toolbin conflict: {link}")
    link.symlink_to(Path(path).absolute())
values["tools"]["path"] = [str(root / "toolbin")]
digest = "2e4e0d991e4258df332c19d8dcf372212fe27f1b18e777d9e1eb25fc2c64a404"
archive = root / "permuter.tar.gz"
if not archive.is_file() or hashlib.sha256(archive.read_bytes()).hexdigest() != digest:
    with urllib.request.urlopen("https://codeload.github.com/simonlindholm/decomp-permuter/tar.gz/059609d4aec73eb0650726772954e1ad575825f8", timeout=60) as stream:
        content = stream.read()
    if hashlib.sha256(content).hexdigest() != digest:
        sys.exit("permuter: pinned SHA256 mismatch")
    atomic.write(archive, content)
values["tools"].update(permuter_archive=str(archive), permuter_sha256=digest)
Host.from_values(values, "check").require_command("check")
atomic.text(root / "unbake.toml", toml.dumps(values))
print(root / "unbake.toml")
PYTHON
