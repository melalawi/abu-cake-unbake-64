#!/bin/sh
set -eu

# Provision the repository's one Python environment and current host config.
if [ "$#" -ne 1 ]; then echo 'usage: ci/setup SCRATCH' >&2; exit 1; fi
for tool in python3 git dirname mkdir make cc; do
    command -v "$tool" >/dev/null 2>&1 || { echo "missing tool: $tool" >&2; exit 1; }
done
cd "$(dirname "$0")/.."
case "$1" in
    /*) ;;
    *) echo 'SCRATCH must be an absolute path' >&2; exit 1 ;;
esac
mkdir -p "$1/tmp"
export TMPDIR="$1/tmp"
bin/dev-setup
.venv/bin/pip install 'splat64==0.50.0' 'm2c @ git+https://github.com/matt-kempster/m2c.git@708d2d2cb2698f091a92492b328f73b24209f72d'
git clone https://github.com/melalawi/abu-mas-n64.git "$1/n64link"
git -C "$1/n64link" checkout --detach 486b1d6bcc72a61930d8b06fe43033c2d11d2c6c
make -C "$1/n64link" -j2
export PATH="$1/n64link/build:$PWD/.venv/bin:$PATH"
exec ci/policy "$1"
