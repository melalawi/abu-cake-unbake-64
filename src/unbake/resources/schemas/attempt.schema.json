{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "unbake:attempt",
 "type": "object",
 "properties": {
  "member": {
   "type": "string",
   "minLength": 1
  },
  "step": {
   "type": "string",
   "minLength": 1
  },
  "source_sha256": {
   "type": "string"
  },
  "recipe": {
   "type": "string"
  },
  "score": {
   "type": "number",
   "minimum": 0,
   "maximum": 1
  },
  "best_before": {
   "type": "number",
   "minimum": 0,
   "maximum": 1
  },
  "outcome": {
   "enum": [
    "exact",
    "better",
    "same",
    "worse",
    "failed"
   ]
  },
  "symptoms": {
   "type": "object",
   "properties": {
    "size_delta_bytes": {
     "type": "integer"
    },
    "bytes_differ": {
     "type": "boolean"
    },
    "unproved": {
     "type": "boolean"
    },
    "no_measurement": {
     "type": "boolean"
    },
    "compile_failed": {
     "type": "boolean"
    },
    "unresolved": {
     "type": "boolean"
    },
    "repeated_deleted_runs": {
     "type": "integer",
     "minimum": 0
    },
    "register_dominant": {
     "type": "boolean"
    },
    "float_register_differences": {
     "type": "integer",
     "minimum": 0
    },
    "frame_delta_bytes": {
     "type": "integer"
    },
    "sp_offset_only": {
     "type": "boolean"
    },
    "literal_immediates_off_four": {
     "type": "integer",
     "minimum": 0
    },
    "missing_struct_member": {
     "type": "boolean"
    },
    "plateau_probes": {
     "type": "integer",
     "minimum": 0
    },
    "score": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    }
   },
   "required": [],
   "additionalProperties": false
  },
  "hints": {
   "type": "array",
   "items": {
    "type": "string",
    "minLength": 1
   }
  },
  "subsystem": {
   "type": "string",
   "minLength": 1
  },
  "note": {
   "type": "string"
  },
  "invocation": {
   "type": "string",
   "minLength": 1
  },
  "time": {
   "type": "string",
   "minLength": 1
  }
 },
 "required": [
  "member",
  "step",
  "source_sha256",
  "recipe",
  "score",
  "best_before",
  "outcome",
  "symptoms",
  "hints",
  "subsystem",
  "note",
  "invocation",
  "time"
 ],
 "additionalProperties": false
}
