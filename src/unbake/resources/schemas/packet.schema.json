      "type": "string",
      "minLength": 1
     }
    },
    "headers": {
     "type": "array",
     "items": {
      "type": "string",
      "minLength": 1
     }
    },
    "compiler": {
     "type": "array",
     "items": {
      "type": "string",
      "minLength": 1
