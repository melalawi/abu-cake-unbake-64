{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "unbake:project",
 "type": "object",
 "properties": {
  "schema": {
   "const": 3
  },
  "project": {
   "type": "object",
   "properties": {
    "id": {
     "type": "string",
     "minLength": 1
    },
    "name": {
     "type": "string",
     "minLength": 1
    },
    "title": {
     "type": "string",
     "minLength": 1
    },
    "versions": {
     "type": "array",
     "items": {
      "type": "string",
      "minLength": 1
     }
    },
    "names_from": {
     "type": "string",
     "minLength": 1
    },
    "toolchain": {
     "type": "string",
     "minLength": 1
    },
    "layout_cap": {
     "type": "integer",
     "minimum": 1
    }
   },
   "required": [
    "id",
    "name",
    "title",
    "versions",
    "names_from",
    "toolchain",
    "layout_cap"
   ],
   "additionalProperties": false
  },
  "build": {
   "type": "object",
   "properties": {
    "cppflags": {
     "type": "array",
     "items": {
      "type": "string",
      "minLength": 1
     }
    },
    "cflags": {
     "type": "array",
     "items": {
      "type": "string",
      "minLength": 1
     }
    },
    "asflags": {
     "type": "array",
     "items": {
      "type": "string",
      "minLength": 1
     }
    },
    "gnu_asflags": {
     "type": "array",
     "items": {
      "type": "string",
      "minLength": 1
     }
    },
    "text_mask": {
     "type": "integer",
     "minimum": 1,
     "maximum": 4294967295
    }
   },
   "required": [
    "cppflags",
    "cflags",
    "asflags",
    "gnu_asflags"
   ],
   "additionalProperties": false
  },
  "version": {
   "type": "object",
   "additionalProperties": {
    "type": "object",
    "properties": {
     "baserom": {
      "type": "string",
      "minLength": 1
     },
     "baserom_sha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
     },
     "split": {
      "type": "string",
      "minLength": 1
     },
     "symbols": {
      "type": "string",
      "minLength": 1
     },
     "macros": {
      "type": "array",
      "items": {
       "type": "string",
       "minLength": 1
      }
     },
     "cartridge_id": {
      "type": "string",
      "minLength": 1
     },
     "region": {
      "type": "string",
      "minLength": 1
     },
     "description": {
      "type": "string",
      "minLength": 1
     }
    },
    "required": [
     "baserom",
     "baserom_sha1",
     "split",
     "symbols",
     "macros"
    ],
    "additionalProperties": false
   }
  },
  "resident": {
   "type": "object",
   "additionalProperties": {
    "type": "array",
    "items": {
     "type": "object",
     "properties": {
      "start": {
       "type": "integer",
       "minimum": 0
      },
      "end": {
       "type": "integer",
       "minimum": 0
      },
      "address": {
       "type": "integer",
       "minimum": 0
      },
      "table_entry_bias": {
       "type": "integer",
       "minimum": 0
      }
     },
     "required": [
      "start",
      "end",
      "address",
      "table_entry_bias"
     ],
     "additionalProperties": false
    }
   }
  }
 },
 "required": [
  "schema",
  "project",
  "build",
  "version",
  "resident"
 ],
 "additionalProperties": false
}
