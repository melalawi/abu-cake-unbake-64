       "additionalProperties": false
      },
      "types": {
       "type": "object",
       "properties": {
        "hits": {
         "type": "integer",
         "minimum": 0
        },
        "total": {
         "type": "integer",
         "minimum": 0
        },
        "misses": {
         "type": "array"
        }
       },
       "required": [
        "hits",
        "total",
        "misses"
       ],
       "additionalProperties": false
      }
