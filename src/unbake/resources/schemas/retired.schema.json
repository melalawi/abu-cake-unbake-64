{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "unbake:retired",
 "type": "object",
 "properties": {
  "schema": {
   "const": 1
  },
  "retired": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "file": {
      "enum": [
       "host",
       "project",
       "layout"
      ]
     },
     "key": {
      "type": "string",
      "minLength": 1
     },
     "replacement": {
      "type": "string"
     },
     "note": {
      "type": "string",
      "minLength": 1
     }
    },
    "required": [
     "file",
     "key",
     "replacement",
     "note"
    ],
    "additionalProperties": false
   }
  }
 },
 "required": [
  "schema",
  "retired"
 ],
 "additionalProperties": false
}
