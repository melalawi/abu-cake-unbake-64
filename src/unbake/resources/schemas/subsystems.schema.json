{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "unbake:subsystems",
 "type": "object",
 "properties": {
  "schema": {
   "const": 1
  },
  "subsystem": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string",
      "minLength": 1
     },
     "label": {
      "type": "string",
      "minLength": 1
     },
     "rank": {
      "type": "integer",
      "minimum": 0
     },
     "calls": {
      "type": "array",
      "items": {
       "type": "string",
       "minLength": 1
      }
     },
     "mnemonics": {
      "type": "array",
      "items": {
       "type": "string",
       "minLength": 1
      }
     },
     "lui": {
      "type": "array",
      "items": {
       "type": "integer",
       "minimum": 0
      }
     },
     "weight": {
      "type": "number"
     },
     "idioms": {
      "type": "array",
      "items": {
       "type": "string",
       "minLength": 1
      }
     },
     "structs": {
      "type": "array",
      "items": {
       "type": "string",
       "minLength": 1
      }
     },
     "headers": {
      "type": "array",
      "items": {
       "type": "string",
       "minLength": 1
      }
     },
     "compiler": {
      "type": "array",
      "items": {
       "type": "string",
       "minLength": 1
      }
     },
     "sources": {
      "type": "array",
      "items": {
       "type": "string",
       "minLength": 1
      }
     }
    },
    "required": [
     "id",
     "label",
     "rank",
     "calls",
     "mnemonics",
     "lui",
     "weight",
     "idioms",
     "structs",
     "headers",
     "compiler",
     "sources"
    ],
    "additionalProperties": false
   }
  }
 },
 "required": [
  "schema",
  "subsystem"
 ],
 "additionalProperties": false
}
