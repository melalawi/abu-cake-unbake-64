name: CI
on:  # progress sites read the report artifacts; a run per push floods them, so main reports on a schedule
  schedule:
    - cron: "0 */6 * * *"
  pull_request:
  workflow_dispatch:
permissions:
  contents: read
jobs:
  check:
    runs-on: ubuntu-latest
    steps:
      - uses: ${checkout}
      - run: make check CHECK=tree
${uploads}
